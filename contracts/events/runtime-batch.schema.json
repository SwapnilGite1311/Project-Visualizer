{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/events/runtime-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "events"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "version",
        "service",
        "project_root"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "runtime-event.schema.json"
      },
      "maxItems": 5000
    }
  }
}
