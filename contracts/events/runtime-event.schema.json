{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/events/runtime-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "trace_id",
    "span_id",
    "kind",
    "name",
    "start_ns"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "span_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "call",
        "http_in",
        "http_out",
        "db_query",
        "message",
        "error",
        "stall",
        "log"
      ]
    },
    "name": {
      "type": "string"
    },
    "file_path": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 0
    },
    "start_ns": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ns": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "stack"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "stack": {
              "type": "string"
            }
          }
        }
      ]
    },
    "attrs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "service": {
      "type": "string"
    },
    "pid": {
      "type": "integer"
    },
    "thread": {
      "type": "string"
    }
  }
}
