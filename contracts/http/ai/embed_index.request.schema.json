{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/http/ai/embed_index.request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_key",
    "items"
  ],
  "properties": {
    "project_key": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "text"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        }
      },
      "maxItems": 500
    }
  }
}
