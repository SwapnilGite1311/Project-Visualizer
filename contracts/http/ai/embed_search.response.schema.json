{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/http/ai/embed_search.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hits"
  ],
  "properties": {
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "score"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  }
}
