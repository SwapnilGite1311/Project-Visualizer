{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/http/ml/recommend.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "reasons",
    "actions",
    "markdown"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "go",
        "caution",
        "no_go"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "markdown": {
      "type": "string"
    }
  }
}
