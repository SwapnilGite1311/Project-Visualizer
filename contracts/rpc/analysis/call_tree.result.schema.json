{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/analysis/call_tree.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "root_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "../../common/node.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "../../common/edge.schema.json"
      }
    }
  }
}
