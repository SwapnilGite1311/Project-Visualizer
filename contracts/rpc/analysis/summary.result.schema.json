{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/analysis/summary.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_path",
    "files",
    "total_loc",
    "languages",
    "counts",
    "externals",
    "largest_modules",
    "largest_packages",
    "syntax_error_files",
    "parse_errors"
  ],
  "properties": {
    "root_path": {
      "type": "string"
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "total_loc": {
      "type": "integer",
      "minimum": 0
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "loc"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "loc": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "package",
        "module",
        "class",
        "function",
        "method",
        "variable",
        "statement",
        "external"
      ],
      "properties": {
        "project": {
          "type": "integer",
          "minimum": 0
        },
        "package": {
          "type": "integer",
          "minimum": 0
        },
        "module": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "integer",
          "minimum": 0
        },
        "function": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "type": "integer",
          "minimum": 0
        },
        "variable": {
          "type": "integer",
          "minimum": 0
        },
        "statement": {
          "type": "integer",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "externals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "largest_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "name",
          "loc"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "loc": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 10
    },
    "largest_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "name",
          "loc",
          "modules"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "loc": {
            "type": "integer",
            "minimum": 0
          },
          "modules": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 10
    },
    "syntax_error_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parse_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
