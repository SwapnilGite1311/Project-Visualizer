{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/cache/status.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dir",
    "files",
    "hits",
    "misses",
    "bytes"
  ],
  "properties": {
    "dir": {
      "type": "string"
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "hits": {
      "type": "integer",
      "minimum": 0
    },
    "misses": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
