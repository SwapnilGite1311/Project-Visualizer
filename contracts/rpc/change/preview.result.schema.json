{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/change/preview.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change",
    "affected",
    "risk",
    "breakdown"
  ],
  "properties": {
    "change": {
      "$ref": "preview.params.schema.json#/$defs/change"
    },
    "affected": {
      "$ref": "../impact/analyze.result.schema.json#/properties/affected"
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "level",
        "factors"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "maxItems": 6,
          "description": "impact.analyze's 3 factors, then the change type, recent runs and unhealthy parts when they apply"
        }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_score",
        "type_multiplier",
        "runtime_bonus"
      ],
      "properties": {
        "static_score": {
          "type": "integer",
          "minimum": 0
        },
        "type_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "runtime_bonus": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
