{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/deps/cycles.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycles"
  ],
  "properties": {
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_ids"
        ],
        "properties": {
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    }
  }
}
