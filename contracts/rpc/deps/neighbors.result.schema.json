{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/deps/neighbors.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_id",
    "items",
    "edges"
  ],
  "properties": {
    "root_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "distance",
          "direction",
          "ancestor_ids"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "distance": {
            "type": "integer",
            "minimum": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "ancestor_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "../../common/edge.schema.json"
      }
    }
  }
}
