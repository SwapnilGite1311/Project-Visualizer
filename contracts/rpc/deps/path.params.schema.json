{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/deps/path.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "from_id",
    "to_id"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "from_id": {
      "type": "string",
      "minLength": 1
    },
    "to_id": {
      "type": "string",
      "minLength": 1
    },
    "kinds": {
      "type": "array",
      "items": {
        "$ref": "../../common/enums.schema.json#/$defs/edge_kind"
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  }
}
