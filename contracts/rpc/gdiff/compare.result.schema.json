{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/gdiff/compare.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "added",
    "removed",
    "changed",
    "edges_added",
    "edges_removed",
    "packages"
  ],
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "fields"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges_added": {
      "type": "integer",
      "minimum": 0
    },
    "edges_removed": {
      "type": "integer",
      "minimum": 0
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "added",
          "removed",
          "changed"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          },
          "changed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
