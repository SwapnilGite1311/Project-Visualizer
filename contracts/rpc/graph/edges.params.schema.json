{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/graph/edges.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "node_id"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "$ref": "../../common/enums.schema.json#/$defs/direction"
    },
    "kinds": {
      "type": "array",
      "items": {
        "$ref": "../../common/enums.schema.json#/$defs/edge_kind"
      }
    }
  }
}
