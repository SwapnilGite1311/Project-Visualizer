{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/health/changed.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "changes"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "from",
          "to"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "from": {
            "$ref": "../../common/enums.schema.json#/$defs/health"
          },
          "to": {
            "$ref": "../../common/enums.schema.json#/$defs/health"
          }
        }
      }
    }
  }
}
