{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/health/get.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "states"
  ],
  "properties": {
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "calls",
          "errors",
          "error_rate",
          "p95_ms",
          "stalled",
          "reason"
        ],
        "properties": {
          "state": {
            "$ref": "../../common/enums.schema.json#/$defs/health"
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "error_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p95_ms": {
            "type": "number"
          },
          "stalled": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
