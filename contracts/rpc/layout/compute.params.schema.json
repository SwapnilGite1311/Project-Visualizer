{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/layout/compute.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "mode"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "2d",
        "3d"
      ]
    },
    "rankdir": {
      "type": "string",
      "enum": [
        "TB",
        "LR"
      ]
    }
  }
}
