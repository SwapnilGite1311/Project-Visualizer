{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/modtrace/follow.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "trace_id",
    "direction"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "forward",
        "backward"
      ]
    },
    "from_node_id": {
      "type": "string"
    }
  }
}
