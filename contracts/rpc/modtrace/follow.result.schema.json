{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/modtrace/follow.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hops"
  ],
  "properties": {
    "hops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_id",
          "to_id",
          "start_ns",
          "duration_ns",
          "status"
        ],
        "properties": {
          "from_id": {
            "type": "string"
          },
          "to_id": {
            "type": "string"
          },
          "start_ns": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ns": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          }
        }
      }
    }
  }
}
