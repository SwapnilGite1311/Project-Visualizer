{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/project/progress.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "state",
    "files_total",
    "files_done"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "$ref": "../../common/enums.schema.json#/$defs/project_state"
    },
    "files_total": {
      "type": "integer",
      "minimum": 0
    },
    "files_done": {
      "type": "integer",
      "minimum": 0
    }
  }
}
