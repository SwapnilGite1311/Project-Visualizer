{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/project/status.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "root_path",
    "state",
    "files_total",
    "files_done",
    "error_message"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "root_path": {
      "type": "string"
    },
    "state": {
      "$ref": "../../common/enums.schema.json#/$defs/project_state"
    },
    "files_total": {
      "type": "integer",
      "minimum": 0
    },
    "files_done": {
      "type": "integer",
      "minimum": 0
    },
    "error_message": {
      "type": "string"
    }
  }
}
