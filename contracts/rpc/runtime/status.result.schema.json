{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/runtime/status.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "active",
    "events_total",
    "events_buffered",
    "last_event_ms",
    "services"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "events_total": {
      "type": "integer",
      "minimum": 0
    },
    "events_buffered": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_ms": {
      "type": "integer"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
