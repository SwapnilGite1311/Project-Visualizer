{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/runtime/trace.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "steps"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "span_id",
          "parent_span_id",
          "node_id",
          "name",
          "kind",
          "start_ns",
          "duration_ns",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "span_id": {
            "type": "string"
          },
          "parent_span_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "start_ns": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ns": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          }
        }
      }
    }
  }
}
