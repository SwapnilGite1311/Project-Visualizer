{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/search/suggest.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "prefix"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "prefix": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
