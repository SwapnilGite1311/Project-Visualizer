{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/sim/flows.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "count",
          "failed",
          "edge_id"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "edge_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
