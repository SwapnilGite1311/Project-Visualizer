{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/snapshot/export.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "engine_version",
    "label",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "pv-snapshot-1"
    },
    "engine_version": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "../../common/node.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "../../common/edge.schema.json"
      }
    }
  }
}
