{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pv.local/schemas/rpc/watch/start.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 250,
      "maximum": 60000
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "native",
        "poll"
      ]
    }
  }
}
