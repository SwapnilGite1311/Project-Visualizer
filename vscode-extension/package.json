{
  "name": "project-visualizer",
  "displayName": "Project Visualizer",
  "description": "Jump between your code and its living map in Project Visualizer.",
  "version": "0.1.0",
  "publisher": "project-visualizer",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/SwapnilGite1311/Project-Visualizer.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectVisualizer.showOnMap",
        "title": "Project Visualizer: Show on map"
      },
      {
        "command": "projectVisualizer.explain",
        "title": "Project Visualizer: Explain this"
      },
      {
        "command": "projectVisualizer.reconnect",
        "title": "Project Visualizer: Reconnect"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
